# Copy this file to .env. Keep .env private and never commit your API key.
GEMINI_API_KEY=
# Use a currently supported Gemini model. Change if your account does not have access.
GEMINI_MODEL=gemini-2.5-flash
# Set true to test end-to-end without an API key. Demo output is a template, not AI output.
DEMO_MODE=false
BACKEND_URL=http://127.0.0.1:8000
